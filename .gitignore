config.php
# Marker written by install/step5.php once the wizard has run. It is what
# install/.htaccess and install/guard.php key off to lock the installer, so it
# must exist on the deployed server but must never be committed - a clone that
# shipped it would present a locked installer to a server that still needs one.
install/.installed
.DS_Store
.vscode/
ui/ui/compiled
ui/compiled/*.php
ui/cache/*.php
test.php
sms.php
pages/
system/cache/**
system/plugin/*
!system/cache/index.html
!system/plugin/index.html
system/paymentgateway/ui/**
system/paymentgateway/**
!system/paymentgateway/ui/
!system/paymentgateway/ui/index.html
!system/paymentgateway/index.html
# Gateways we ship from this repository must survive a fresh clone, otherwise
# a live server pulled from git would have no Tranzak module at all.
!system/paymentgateway/tranzak.php
!system/paymentgateway/ui/tranzak.tpl
!system/plugin/ui/
system/plugin/ui/*
!system/plugin/ui/index.html
ui/ui_custom/**
!ui/ui_custom/index.html
!ui/ui_custom/README.md
# system/uploads holds user-supplied files at runtime, but PHPNuxBill reads
# some of these defaults unconditionally. A live server pulled from git has no
# init.php guard around notifications.default.json, so its absence takes down
# every page, not just the admin. Ship the defaults, ignore the rest.
system/uploads/*
!system/uploads/*.default.png
!system/uploads/*.default.jpg
!system/uploads/notifications.default.json
!system/uploads/index.html
# Re-include the subdirectories themselves: git will not descend into an
# excluded directory, which would make the index.html negations below no-ops.
!system/uploads/sms/
!system/uploads/system/
!system/uploads/_sysfrm_tmp_/
system/uploads/sms/*
!system/uploads/sms/index.html
system/uploads/system/*
!system/uploads/system/index.html
system/uploads/_sysfrm_tmp_/*
!system/uploads/_sysfrm_tmp_/index.html
ui/themes/**
!ui/themes/index.html
!ui/themes/README.md
scanLang.php
system/lan/**
!system/lan/index.html
!system/lan/indonesia.json
!system/lan/spanish.json
!system/lan/turkish.json
!system/lan/english.json
!system/lan/country.json
